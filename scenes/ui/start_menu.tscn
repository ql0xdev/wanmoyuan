[ext_resource type="Script" path="res://scenes/ui/safe_area.gd" id="3_safe"]
[ext_resource type="Script" path="res://scenes/ui/ui_backdrop.gd" id="4_backdrop"]

[node name="StartMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_start")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("4_backdrop")
emblem = true

[node name="Center" type="CenterContainer" parent="."]
clip_contents = true
layout_mode = 1
mouse_filter = 2
script = ExtResource("3_safe")

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 18

[node name="Wordmark" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.545098, 0.580392, 0.619608, 1)
